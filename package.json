{
  "scripts": {
    "screenshots": "node scripts/render-screenshots.mjs",
    "check:screenshots": "node scripts/render-screenshots.mjs --check",
    "check:layout": "node scripts/check-layout.mjs chromium",
    "check:webkit": "node scripts/check-layout.mjs webkit",
    "check:identity": "node scripts/check-identity.mjs",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "check-release": "node scripts/check-release.mjs",
    "lint": "eslint 'src/**/*.ts' --max-warnings=0",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "lint:css": "stylelint styles.css",
    "lint:deps": "eslint -c eslint.deps.config.mjs package.json --max-warnings=0",
    "lint:cloud-parity": "node scripts/lint-cloud-parity.mjs",
    "check:dead-code": "knip --production && knip --no-config-hints --include dependencies,unlisted,binaries,unresolved",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  },
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/markdown": "1.6.4",
    "@types/node": "^24",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-depend": "1.5.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "happy-dom": "21.0.4",
    "jsonc-eslint-parser": "3.3.0",
    "knip": "6.43.0",
    "moment": "2.31.0",
    "obsidian": "1.14.4",
    "playwright": "1.64.1",
    "stylelint": "17.16.0",
    "stylelint-no-unsupported-browser-features": "8.1.2",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.72.1",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "name": "organized",
  "overrides": {
    "@lezer/common": "1.5.1",
    "@lezer/highlight": "1.2.3",
    "eslint": {
      "minimatch": "11.0.1"
    },
    "eslint-plugin-obsidianmd": {
      "moment": "2.31.0"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    },
    "eslint-plugin-n": {
      "minimatch": "11.0.1"
    },
    "eslint-plugin-json-schema-validator": {
      "minimatch": "11.0.1"
    }
  },
  "version": "0.1.6",
  "private": true,
  "description": "Markdown-backed tasks, calendar and inspector for Obsidian",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11.10.0"
  }
}
